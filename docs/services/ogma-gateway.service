[Unit]
Description=OgmaOS LoRaWAN Packet Forwarder (SX1302)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/sx1302_hal/packet_forwarder
ExecStart=/root/sx1302_hal/packet_forwarder/lora_pkt_fwd
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
